#include <stdio.h>

struct Sensor
{
    int id;
    float reading;
};

int main()
{
    struct Sensor s1;

    printf("Enter Sensor ID: ");
    scanf("%d", &s1.id);

    printf("Enter Sensor Reading: ");
    scanf("%f", &s1.reading);

    printf("\nSensor Details\n");
    printf("ID = %d\n", s1.id);
    printf("Reading = %.2f\n", s1.reading);

    return 0;
}
