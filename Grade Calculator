#include<stdio.h>
#include<conio.h>

void main()
{
    int marks;
    clrscr();

    printf("Enter marks: ");
    scanf("%d",&marks);

    if(marks>=90 && marks<=100)
        printf("Grade A");
    else if(marks>=75)
        printf("Grade B");
    else if(marks>=60)
        printf("Grade C");
    else if(marks>=40)
        printf("Grade D");
    else if(marks>=0)
        printf("Fail");
    else
        printf("Invalid Marks");

    getch();
}
